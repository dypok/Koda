{
  "name": "koda-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Koda — Plataforma educativa interactiva y gamificada para aprender programación",
  "scripts": {
    "dev": "pnpm --filter \"@koda/types\" build && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "test": "pnpm --filter \"./apps/*\" test",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter api db:seed",
    "validate:content": "node scripts/validate-content.js",
    "generate:roadmap": "node scripts/generate-lua-roadmap.js"
  },
  "keywords": [
    "koda",
    "learning",
    "gamification",
    "nextjs",
    "nestjs",
    "python"
  ],
  "author": "Koda Team",
  "license": "MIT",
  "packageManager": "pnpm@12.0.0"
}
