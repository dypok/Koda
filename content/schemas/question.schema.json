            "example",
            "exercise",
            "quiz",
            "review"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "coming_soon",
            "published",
            "archived"
          ],
          "default": "published"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 120
        },
        "xp_on_complete": {
          "type": "integer",
          "minimum": 0
        },
        "graph": {
