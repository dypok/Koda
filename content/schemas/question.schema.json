              "type": "integer",
              "minimum": 0
            }
          }
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/question"
}
