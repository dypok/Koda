        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "code",
        "slug",
        "title",
        "position",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "language_id": {
          "type": "string"
        },
        "course_id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "objective": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "coming_soon",
            "published",
            "archived"
          ],
          "default": "published"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "prerequisite_module_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "quiz": {
              "type": "integer",
              "minimum": 50,
              "maximum": 90
            },
            "exam": {
              "type": "integer",
              "minimum": 60,
              "maximum": 95
