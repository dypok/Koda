        {
          "id": "les_py_02_01",
          "code": "L01",
          "title": "Cajas con nombre en memoria",
          "position": 1,
          "explanation": "Una variable es un contenedor con un nombre asignado donde guardamos información en la memoria de la computadora. En Python, creas una variable escribiendo su nombre, seguido del operador de asignación `=` y el valor.",
          "concept_id": "py-variables-y-tipos-de-datos-l01",
          "is_required": true,
          "status": "published",
          "content_version": 1,
          "examples": [
            {
              "title": "Ejemplo",
              "code": "vidas = 3\nprint(vidas)",
              "language": "python",
              "output": "3",
              "explanation": "El signo `=` en programación significa 'asigna este valor a la variable', no igualdad matemática.",
              "position": 1
            }
          ],
          "exercises": [
