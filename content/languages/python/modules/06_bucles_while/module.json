          "id": "les_py_06_01",
          "title": "La estructura básica de while",
          "slug": "estructura-while",
          "position": 1,
          "concept_id": "py-while-syntax",
          "explanation": "El bucle while repite su bloque de código mientras una condición booleana sea verdadera (True). Antes de cada ciclo evalúa la condición; si es falsa, el bucle termina.",
          "is_required": true,
          "examples": [
            {
              "title": "Conteo regresivo",
              "code": "segundos = 3\nwhile segundos > 0:\n    print(segundos)\n    segundos -= 1",
              "output": "3\n2\n1",
              "explanation": "El ciclo se repite mientras segundos sea mayor a cero, restando 1 en cada iteración.",
              "language": "python",
              "position": 1
            }
          ],
          "exercises": [
