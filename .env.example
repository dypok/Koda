# ==========================================
# KODA — Variables de Entorno de Ejemplo
# ==========================================
# Copia este archivo a .env o configúralo en tu gestor de secretos.
# Nunca subas valores reales o claves de producción a git.

# ------------------------------------------
# 1. Configuración del Servidor Backend (apps/api)
# ------------------------------------------
PORT=4000
NODE_ENV=development
TZ=America/Bogota

# ------------------------------------------
# 2. Base de Datos Supabase (PostgreSQL 15+)
# ------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# 3. Autenticación y Seguridad (JWT Stateless)
# ------------------------------------------
JWT_SECRET=koda_dev_access_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=koda_dev_refresh_secret_key_minimum_32_characters_random
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# 4. Almacenamiento y Caché
# ------------------------------------------
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb://localhost:27017/koda

# ------------------------------------------
# 5. Object Storage (Siigo S3 Compatible Storage)
# ------------------------------------------
STORAGE_DRIVER=siigo
SIIGO_ENDPOINT=http://localhost:9000
SIIGO_PORT=9000
SIIGO_ACCESS_KEY=koda_admin
SIIGO_SECRET_KEY=koda_secret_key_2026
SIIGO_REGION=us-east-1
SIIGO_BUCKET_CERTIFICATES=certificates
SIIGO_BUCKET_AVATARS=avatars
SIIGO_USE_SSL=false

# ------------------------------------------
# 6. Frontend Web (apps/web)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
