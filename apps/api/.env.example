# apps/api — Variables de entorno específicas del Backend NestJS
PORT=4000
NODE_ENV=development
TZ=America/Bogota

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# MongoDB (contenido curricular: tracks, cursos, módulos, secciones, lecciones)
# Levanta un Mongo local desde la raíz del monorepo con: docker compose up -d mongo
MONGODB_URI=mongodb://localhost:27017/koda

# JWT Auth
JWT_SECRET=koda_dev_access_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=koda_dev_refresh_secret_key_minimum_32_characters_random
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Supabase Storage de Certificados
SUPABASE_STORAGE_CERTIFICATES_BUCKET=certificates
